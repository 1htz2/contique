# URL pública do site (links, OG e Pixel). Produção: https://contique.vercel.app ou o domínio próprio. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Settings > API). A service role key é só do servidor: nunca use NEXT_PUBLIC_ nela.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Preços em reais. O servidor cobra estes valores; a interface exibe os mesmos.
BOOK_PRICE_BRL=14.90
COLORING_BOOK_PRICE_BRL=6.90

# Mercado Pago (Suas integrações > Credenciais). Credenciais de teste no sandbox.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Suas integrações > Webhooks > Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=

# Texto: anthropic | template (história modelo, sem IA; útil para desenvolvimento)
TEXT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
STORY_MODEL=claude-opus-5-5
VISION_MODEL=claude-opus-5-5

# Imagens: gemini | openai | mock (ilustração desenhada localmente, sem IA)
IMAGE_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# 1K (~1024 px, US$ 0,034 por imagem no Gemini) ou 2K (US$ 0,050)
IMAGE_SIZE=1K
IMAGE_CONCURRENCY=4

# Teto de prévias por dia (o único gasto sem venda). Retenção dos livros gerados, em dias.
MAX_PREVIEWS_PER_DAY=800
BOOK_RETENTION_DAYS=30
# Câmbio usado no admin para "receita menos IA"
USD_BRL_RATE=5.40

# Protege /api/cron/maintenance (a Vercel envia Authorization: Bearer $CRON_SECRET). Mínimo 16 caracteres.
CRON_SECRET=

# Acesso ao /admin (Basic Auth). Senha com pelo menos 12 caracteres.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Meta Pixel + Conversions API (opcional: sem ID, nada é carregado)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# TikTok Pixel + Events API (opcional)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Google Analytics 4 (opcional)
NEXT_PUBLIC_GA_ID=
